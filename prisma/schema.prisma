generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "postgresql"
  url      = env("DATABASE_URL")
}

enum UserRole {
  FAMILY_ADMIN
  FAMILY_MEMBER
  CAREGIVER
  CPS_CASEWORKER
  ADVOCATE
  READ_ONLY
}

enum PlatformRole {
  USER
  SUPER_ADMIN
  PLATFORM_ADMIN
  SUPPORT_ADMIN
}

enum ChildRelationshipStatus {
  ACTIVE
  INVITED
  PENDING_APPROVAL
  DENIED
  REVOKED
}

enum ChildRelationshipType {
  PARENT_GUARDIAN
  CAREGIVER
  EMERGENCY_CONTACT
  CPS_CASEWORKER
  ADVOCATE
  FOSTER_PARENT
  READ_ONLY
}

enum AuthorizedEmailStatus {
  AUTHORIZED
  INVITED
  ACTIVE
  SUSPENDED
  REVOKED
}

enum ApplicationStatus {
  PENDING
  NEEDS_REVIEW
  APPROVED
  DENIED
  WAITLISTED
}

enum ApplicationType {
  FAMILY
  CASEWORKER
  ADVOCATE
  ORGANIZATION
}

enum AccountType {
  FAMILY
  CAREGIVER
  CASEWORKER
  ADVOCATE
  ORGANIZATION_ADMIN
  READ_ONLY
}

enum OrganizationType {
  CPS
  NONPROFIT
  ADVOCACY
  HEALTHCARE
  SCHOOL
  OTHER
}

enum OrganizationStatus {
  PENDING_APPROVAL
  ACTIVE
  SUSPENDED
}

enum CaseStatus {
  OPEN
  MONITORING
  CLOSED
  ARCHIVED
}

enum DoseStatus {
  GIVEN
  LATE
  MISSED
  REFUSED
}

enum LogType {
  MEDICATION
  DOCTOR_VISIT
  BLOODWORK
}

enum DocumentType {
  PDF
  IMAGE
  LAB_RESULT
  DOCTOR_PAPERWORK
  OTHER
}

enum InvitationStatus {
  PENDING
  ACCEPTED
  EXPIRED
  REVOKED
}

enum SponsorshipStatus {
  PENDING
  ACTIVE
  ENDED
}

enum AuditAction {
  LOG_CREATED
  DOCUMENT_UPLOADED
  INVITATION_SENT
  INVITATION_ACCEPTED
  CASE_UPDATED
  ACCESS_CHANGED
  ORGANIZATION_APPROVED
  ORGANIZATION_DENIED
  FAMILY_CREATED
  FAMILY_UPDATED
  CHILD_CREATED
  CHILD_UPDATED
  CHILD_ARCHIVED
  GUARDIAN_ASSIGNED
  GUARDIAN_REMOVED
  CAREGIVER_ASSIGNED
  CASEWORKER_ASSIGNED
  EMERGENCY_CONTACT_LINKED
  ACCESS_REQUEST_SUBMITTED
  ACCESS_REQUEST_APPROVED
  ACCESS_REQUEST_DENIED
  CHILD_CONNECTED_TO_FAMILY
  ADDRESS_UPDATED
  USER_APPROVED
  USER_DENIED
  SENSITIVE_DATA_UPDATED
  SENSITIVE_DATA_VIEWED
  EXPORT_CREATED
}

model User {
  id                  String       @id @default(cuid())
  name                String?
  preferredName       String?
  email               String       @unique
  emailVerified       DateTime?
  image               String?
  phone               String?
  streetAddress       String?
  city                String?
  state               String?
  zip                 String?
  preferredContact    String?
  relationshipToChild String?
  adultMedications    String?
  adultConditions     String?
  emergencyContact    Json?
  hasActiveCase       Boolean      @default(false)
  caseworkerName      String?
  caseworkerEmail     String?
  caseworkerPhone     String?
  onboardingCompleted Boolean      @default(false)
  platformRole        PlatformRole @default(USER)
  passwordHash        String?
  passwordSetAt       DateTime?
  resetTokenHash      String?
  resetTokenExpiresAt DateTime?
  createdAt           DateTime     @default(now())
  updatedAt           DateTime     @updatedAt

  accounts                Account[]
  sessions                Session[]
  familyMemberships       FamilyMembership[]
  organizationMemberships OrganizationMembership[]
  caseParticipants        CaseParticipant[]
  createdCases            Case[]                   @relation("CaseCreator")
  medicationLogs          MedicationLog[]          @relation("MedicationAdmin")
  patientMedicationLogs   MedicationLog[]          @relation("MedicationPatient")
  doctorVisitLogs         DoctorVisitLog[]         @relation("DoctorVisitCreator")
  patientDoctorVisitLogs  DoctorVisitLog[]         @relation("DoctorVisitPatient")
  bloodworkLogs           BloodworkLog[]           @relation("BloodworkCreator")
  patientBloodworkLogs    BloodworkLog[]           @relation("BloodworkPatient")
  uploadedDocuments       Document[]               @relation("DocumentUploader")
  patientDocuments        Document[]               @relation("DocumentPatient")
  auditLogs               AuditLog[]               @relation("AuditActor")
  sentInvitations         Invitation[]             @relation("InvitationSender")
  receivedInvitations     Invitation[]             @relation("InvitationRecipient")
  childPermissions        ChildPermission[]
  childRelationships      ChildRelationship[]      @relation("ChildRelationshipUser")
  requestedRelationships  ChildRelationship[]      @relation("ChildRelationshipRequester")
  approvedRelationships   ChildRelationship[]      @relation("ChildRelationshipApprover")
  authorizedEmail         AuthorizedEmail?
  submittedApplications   Application[]            @relation("ApplicationSubmitter")
  reviewedApplications    Application[]            @relation("ApplicationReviewer")
  sensitiveProfileData    SensitiveProfileData?
}

model Account {
  id                String  @id @default(cuid())
  userId            String
  type              String
  provider          String
  providerAccountId String
  refresh_token     String?
  access_token      String?
  expires_at        Int?
  token_type        String?
  scope             String?
  id_token          String?
  session_state     String?

  user User @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@unique([provider, providerAccountId])
}

model Session {
  id           String   @id @default(cuid())
  sessionToken String   @unique
  userId       String
  expires      DateTime
  user         User     @relation(fields: [userId], references: [id], onDelete: Cascade)
}

model VerificationToken {
  identifier String
  token      String   @unique
  expires    DateTime

  @@unique([identifier, token])
}

model Organization {
  id             String             @id @default(cuid())
  name           String
  slug           String             @unique
  type           OrganizationType
  status         OrganizationStatus @default(PENDING_APPROVAL)
  approvedDomain String?
  createdAt      DateTime           @default(now())
  updatedAt      DateTime           @updatedAt

  memberships        OrganizationMembership[]
  sponsoredCases     Case[]
  sponsorships       FamilySponsorship[]
  invitations        Invitation[]
  applications       Application[]
  authorizedEmails   AuthorizedEmail[]
  childRelationships ChildRelationship[]
}

model OrganizationMembership {
  id             String   @id @default(cuid())
  organizationId String
  userId         String
  role           UserRole
  isSeatActive   Boolean  @default(false)
  createdAt      DateTime @default(now())

  organization Organization @relation(fields: [organizationId], references: [id], onDelete: Cascade)
  user         User         @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@unique([organizationId, userId])
  @@index([userId, role])
}

model FamilyGroup {
  id          String   @id @default(cuid())
  name        String
  description String?
  createdAt   DateTime @default(now())
  updatedAt   DateTime @updatedAt

  memberships        FamilyMembership[]
  children           FamilyChild[]
  sponsorships       FamilySponsorship[]
  invitations        Invitation[]
  childRelationships ChildRelationship[]
}

model FamilyMembership {
  id            String   @id @default(cuid())
  familyGroupId String
  userId        String
  role          UserRole
  createdAt     DateTime @default(now())

  familyGroup FamilyGroup @relation(fields: [familyGroupId], references: [id], onDelete: Cascade)
  user        User        @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@unique([familyGroupId, userId])
  @@index([userId, role])
}

model ChildProfile {
  id                 String    @id @default(cuid())
  fullName           String
  dateOfBirth        DateTime
  email              String?
  phone              String?
  streetAddress      String?
  allergies          String?
  conditions         String?
  currentMedications String?
  emergencyContacts  Json?
  primaryDoctor      String?
  notes              String?
  caseworkerInfo     Json?
  archivedAt         DateTime?
  createdAt          DateTime  @default(now())
  updatedAt          DateTime  @updatedAt

  families             FamilyChild[]
  cases                CaseChild[]
  medicationLogs       MedicationLog[]
  doctorVisits         DoctorVisitLog[]
  bloodworkLogs        BloodworkLog[]
  documents            Document[]
  permissions          ChildPermission[]
  relationships        ChildRelationship[]
  sensitiveProfileData SensitiveProfileData?
}

model ChildRelationship {
  id               String                  @id @default(cuid())
  childId          String
  userId           String?
  invitedEmail     String?
  fullName         String
  relationshipType ChildRelationshipType
  role             UserRole
  familyGroupId    String?
  caseId           String?
  organizationId   String?
  status           ChildRelationshipStatus @default(ACTIVE)
  requestedById    String
  approvedById     String?
  canAccessPortal  Boolean                 @default(true)
  notes            String?
  createdAt        DateTime                @default(now())
  updatedAt        DateTime                @updatedAt

  child        ChildProfile  @relation(fields: [childId], references: [id], onDelete: Cascade)
  user         User?         @relation("ChildRelationshipUser", fields: [userId], references: [id], onDelete: SetNull)
  requestedBy  User          @relation("ChildRelationshipRequester", fields: [requestedById], references: [id])
  approvedBy   User?         @relation("ChildRelationshipApprover", fields: [approvedById], references: [id], onDelete: SetNull)
  familyGroup  FamilyGroup?  @relation(fields: [familyGroupId], references: [id], onDelete: SetNull)
  case         Case?         @relation(fields: [caseId], references: [id], onDelete: SetNull)
  organization Organization? @relation(fields: [organizationId], references: [id], onDelete: SetNull)

  @@index([childId, status])
  @@index([userId, status])
  @@index([invitedEmail, status])
  @@index([relationshipType, status])
}

model FamilyChild {
  id            String   @id @default(cuid())
  familyGroupId String
  childId       String
  relationship  String?
  createdAt     DateTime @default(now())

  familyGroup FamilyGroup  @relation(fields: [familyGroupId], references: [id], onDelete: Cascade)
  child       ChildProfile @relation(fields: [childId], references: [id], onDelete: Cascade)

  @@unique([familyGroupId, childId])
}

model ChildPermission {
  id        String   @id @default(cuid())
  childId   String
  userId    String
  role      UserRole
  caseId    String?
  grantedAt DateTime @default(now())

  child ChildProfile @relation(fields: [childId], references: [id], onDelete: Cascade)
  user  User         @relation(fields: [userId], references: [id], onDelete: Cascade)
  case  Case?        @relation(fields: [caseId], references: [id], onDelete: Cascade)

  @@index([userId, childId, role])
  @@index([caseId])
}

model Case {
  id                       String     @id @default(cuid())
  title                    String
  status                   CaseStatus @default(OPEN)
  createdById              String
  sponsoringOrganizationId String?
  createdAt                DateTime   @default(now())
  updatedAt                DateTime   @updatedAt

  createdBy              User                @relation("CaseCreator", fields: [createdById], references: [id])
  sponsoringOrganization Organization?       @relation(fields: [sponsoringOrganizationId], references: [id])
  children               CaseChild[]
  participants           CaseParticipant[]
  timeline               CaseTimelineEvent[]
  documents              Document[]
  permissions            ChildPermission[]
  invitations            Invitation[]
  childRelationships     ChildRelationship[]
}

model CaseChild {
  id        String   @id @default(cuid())
  caseId    String
  childId   String
  createdAt DateTime @default(now())

  case  Case         @relation(fields: [caseId], references: [id], onDelete: Cascade)
  child ChildProfile @relation(fields: [childId], references: [id], onDelete: Cascade)

  @@unique([caseId, childId])
}

model CaseParticipant {
  id        String   @id @default(cuid())
  caseId    String
  userId    String
  role      UserRole
  createdAt DateTime @default(now())

  case Case @relation(fields: [caseId], references: [id], onDelete: Cascade)
  user User @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@unique([caseId, userId])
  @@index([userId, role])
}

model CaseTimelineEvent {
  id        String   @id @default(cuid())
  caseId    String
  actorId   String?
  label     String
  metadata  Json?
  createdAt DateTime @default(now())

  case Case @relation(fields: [caseId], references: [id], onDelete: Cascade)

  @@index([caseId, createdAt])
}

model MedicationLog {
  id                 String     @id @default(cuid())
  childId            String?
  patientUserId      String?
  medicationName     String
  dosage             Decimal
  doseUnit           String
  dateGiven          DateTime
  timeGiven          String
  administeredById   String?
  administeredByName String?
  status             DoseStatus
  notes              String?
  sideEffects        String?
  batchId            String?
  entryMethod        String     @default("single")
  createdAt          DateTime   @default(now())
  updatedAt          DateTime   @updatedAt

  child          ChildProfile? @relation(fields: [childId], references: [id], onDelete: Cascade)
  patientUser    User?         @relation("MedicationPatient", fields: [patientUserId], references: [id], onDelete: Cascade)
  administeredBy User?         @relation("MedicationAdmin", fields: [administeredById], references: [id])
  documents      Document[]
}

model DoctorVisitLog {
  id               String    @id @default(cuid())
  childId          String?
  patientUserId    String?
  appointmentDate  DateTime
  appointmentTime  String?
  doctorName       String
  specialty        String?
  reasonForVisit   String
  diagnosisOutcome String?
  followUpRequired Boolean   @default(false)
  followUpDate     DateTime?
  createdById      String?
  createdAt        DateTime  @default(now())
  updatedAt        DateTime  @updatedAt

  child       ChildProfile? @relation(fields: [childId], references: [id], onDelete: Cascade)
  patientUser User?         @relation("DoctorVisitPatient", fields: [patientUserId], references: [id], onDelete: Cascade)
  createdBy   User?         @relation("DoctorVisitCreator", fields: [createdById], references: [id])
  documents   Document[]
}

model BloodworkLog {
  id                  String   @id @default(cuid())
  childId             String?
  patientUserId       String?
  bloodworkDate       DateTime
  facility            String?
  orderingDoctor      String?
  labReason           String?
  plateletCount       Decimal?
  hemoglobin          Decimal?
  whiteBloodCellCount Decimal?
  notes               String?
  followUpRequired    Boolean  @default(false)
  createdById         String?
  createdAt           DateTime @default(now())
  updatedAt           DateTime @updatedAt

  child       ChildProfile? @relation(fields: [childId], references: [id], onDelete: Cascade)
  patientUser User?         @relation("BloodworkPatient", fields: [patientUserId], references: [id], onDelete: Cascade)
  createdBy   User?         @relation("BloodworkCreator", fields: [createdById], references: [id])
  documents   Document[]
}

model Document {
  id               String       @id @default(cuid())
  title            String
  type             DocumentType
  fileUrl          String
  fileKey          String
  mimeType         String
  sizeBytes        Int
  uploadedById     String
  patientUserId    String?
  childId          String?
  caseId           String?
  medicationLogId  String?
  doctorVisitLogId String?
  bloodworkLogId   String?
  createdAt        DateTime     @default(now())

  uploadedBy     User            @relation("DocumentUploader", fields: [uploadedById], references: [id])
  patientUser    User?           @relation("DocumentPatient", fields: [patientUserId], references: [id], onDelete: Cascade)
  child          ChildProfile?   @relation(fields: [childId], references: [id], onDelete: Cascade)
  case           Case?           @relation(fields: [caseId], references: [id], onDelete: Cascade)
  medicationLog  MedicationLog?  @relation(fields: [medicationLogId], references: [id], onDelete: Cascade)
  doctorVisitLog DoctorVisitLog? @relation(fields: [doctorVisitLogId], references: [id], onDelete: Cascade)
  bloodworkLog   BloodworkLog?   @relation(fields: [bloodworkLogId], references: [id], onDelete: Cascade)

  @@index([childId, createdAt])
  @@index([caseId, createdAt])
}

model AuditLog {
  id        String      @id @default(cuid())
  actorId   String?
  action    AuditAction
  message   String
  childId   String?
  caseId    String?
  metadata  Json?
  createdAt DateTime    @default(now())

  actor User? @relation("AuditActor", fields: [actorId], references: [id])

  @@index([childId, createdAt])
  @@index([caseId, createdAt])
  @@index([actorId, createdAt])
}

model Invitation {
  id             String           @id @default(cuid())
  email          String
  name           String?
  role           UserRole
  accountType    AccountType?
  status         InvitationStatus @default(PENDING)
  token          String           @unique
  message        String?
  senderId       String
  recipientId    String?
  familyGroupId  String?
  organizationId String?
  caseId         String?
  expiresAt      DateTime
  createdAt      DateTime         @default(now())

  sender       User          @relation("InvitationSender", fields: [senderId], references: [id])
  recipient    User?         @relation("InvitationRecipient", fields: [recipientId], references: [id])
  familyGroup  FamilyGroup?  @relation(fields: [familyGroupId], references: [id], onDelete: Cascade)
  organization Organization? @relation(fields: [organizationId], references: [id], onDelete: Cascade)
  case         Case?         @relation(fields: [caseId], references: [id], onDelete: Cascade)

  @@index([email, status])
}

model AuthorizedEmail {
  id             String                @id @default(cuid())
  email          String                @unique
  name           String?
  defaultRole    UserRole              @default(READ_ONLY)
  accountType    AccountType           @default(FAMILY)
  status         AuthorizedEmailStatus @default(AUTHORIZED)
  userId         String?               @unique
  organizationId String?
  createdById    String?
  createdAt      DateTime              @default(now())
  updatedAt      DateTime              @updatedAt

  user         User?         @relation(fields: [userId], references: [id], onDelete: SetNull)
  organization Organization? @relation(fields: [organizationId], references: [id], onDelete: SetNull)

  @@index([status])
}

model Application {
  id               String            @id @default(cuid())
  type             ApplicationType
  status           ApplicationStatus @default(PENDING)
  email            String
  name             String?
  organizationName String?
  organizationId   String?
  submittedById    String?
  reviewedById     String?
  reviewedAt       DateTime?
  notes            String?
  metadata         Json?
  createdAt        DateTime          @default(now())
  updatedAt        DateTime          @updatedAt

  organization Organization? @relation(fields: [organizationId], references: [id], onDelete: SetNull)
  submittedBy  User?         @relation("ApplicationSubmitter", fields: [submittedById], references: [id], onDelete: SetNull)
  reviewedBy   User?         @relation("ApplicationReviewer", fields: [reviewedById], references: [id], onDelete: SetNull)

  @@index([status, type])
  @@index([email])
}

model SensitiveProfileData {
  id                  String   @id @default(cuid())
  userId              String?  @unique
  childId             String?  @unique
  encryptedSSN        String?
  ssnLast4            String?
  encryptedMedicalId  String?
  encryptedMedicaidId String?
  encryptedNotes      String?
  createdAt           DateTime @default(now())
  updatedAt           DateTime @updatedAt

  user  User?         @relation(fields: [userId], references: [id], onDelete: Cascade)
  child ChildProfile? @relation(fields: [childId], references: [id], onDelete: Cascade)
}

model FamilySponsorship {
  id             String            @id @default(cuid())
  familyGroupId  String
  organizationId String
  status         SponsorshipStatus @default(PENDING)
  startsAt       DateTime?
  endsAt         DateTime?
  createdAt      DateTime          @default(now())

  familyGroup  FamilyGroup  @relation(fields: [familyGroupId], references: [id], onDelete: Cascade)
  organization Organization @relation(fields: [organizationId], references: [id], onDelete: Cascade)

  @@unique([familyGroupId, organizationId])
}
